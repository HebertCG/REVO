# ============================================================
# REVO — Variables de entorno (plantilla)
# ============================================================
# Copia este archivo como .env en la raiz del proyecto:
#     cp .env.example .env
#
# Genera cada secreto con un valor propio y distinto:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# NUNCA subas el .env real al repositorio (.gitignore ya lo excluye).
#
# Los secretos NO tienen valor de ejemplo a proposito. Un secreto publicado
# en un repositorio es un secreto publico, y el arranque falla con un mensaje
# claro si falta alguno, en vez de continuar con una configuracion insegura.
# ============================================================

# ─── Entorno ──────────────────────────────────────────────
# development | production
# En produccion: se cierran /docs y /redoc, se manda HSTS, los errores dejan
# de devolver detalle, y el arranque falla si la configuracion es insegura.
ENVIRONMENT=development

# Puerto publico de la pasarela. Es el UNICO puerto que se publica: los
# microservicios, Postgres y Redis solo existen dentro de la red interna.
PUERTO_PUBLICO=8080


# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=revo_db

# Dueno de las tablas. Se usa SOLO para migraciones. Los servicios NO entran
# con este usuario: si lo hicieran, serian duenos de las tablas y las
# politicas RLS no les aplicarian.
POSTGRES_USER=revo_user
POSTGRES_PASSWORD=

# Rol con el que entran los tres microservicios. No es dueno de nada, asi que
# las politicas RLS le aplican de verdad.
APP_DB_PASSWORD=

# Rol de las tareas de fondo (reentrenamiento del modelo). Lee el dataset
# completo sin tener que hacerse pasar por administrador.
SERVICE_DB_PASSWORD=

# Exigir TLS contra la base de datos. En el compose local es false (la
# conexion no sale de la red interna de Docker). Con una base gestionada
# (Render, Supabase, RDS) debe ser true.
DB_REQUIRE_SSL=false


# ─── Redis ────────────────────────────────────────────────
# Guarda los contadores de rate limit. Es lo que hace que el limite sea por
# alumno y no por worker: sin Redis, cada proceso de uvicorn cuenta aparte y
# el limite real se multiplica por el numero de workers.
REDIS_PASSWORD=


# ─── Autenticacion ────────────────────────────────────────
# Los tres microservicios DEBEN compartir exactamente el mismo valor: cada
# uno valida los tokens que emiten los otros.
# Minimo 32 caracteres; el arranque lo comprueba y rechaza valores de ejemplo.
JWT_SECRET=
JWT_EXPIRE_HOURS=24


# ─── Pasarela ─────────────────────────────────────────────
# Secreto compartido entre Nginx y los servicios. Con REQUIRE_GATEWAY activo,
# un servicio rechaza con 403 cualquier peticion que no lo traiga. Es la
# segunda capa detras del aislamiento de red: aunque un puerto quede
# publicado por error, no se puede hablar con el servicio directamente.
GATEWAY_SECRET=
REQUIRE_GATEWAY=true

# Cuantos proxies propios hay delante de la aplicacion:
#   0 = trafico directo, se ignora X-Forwarded-For por completo
#   1 = solo Nginx (el caso del compose)
#   2 = Cloudflare y luego Nginx
# Con el numero mal puesto, el limite por IP cuenta contra la IP del proxy y
# castiga a todos los alumnos por igual. Con 0 detras de un proxy, cualquiera
# falsifica su IP con una cabecera y estrena cupo en cada peticion.
TRUSTED_PROXY_COUNT=1


# ─── CORS ─────────────────────────────────────────────────
# Lista separada por comas de los origenes exactos del frontend.
# Sin comodines y sin expresiones regulares: el patron anterior
# "https://.*\.vercel\.app" convertia en origen valido cualquier despliegue
# que un tercero subiera a Vercel.
# En produccion todos los origenes deben ser https y el arranque lo verifica.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ─── Frontend ─────────────────────────────────────────────
# El frontend habla SOLO con la pasarela, nunca con los servicios sueltos.
# Un unico origen: no hay tres URLs de API que exponer ni que mantener.
VITE_API_URL=http://localhost:8080/api
