# ============================================================
# REVO - Variables de entorno (plantilla)
# ============================================================
# Copia este archivo como .env en la raiz del proyecto:
#     cp .env.example .env
#
# Despues genera un JWT_SECRET propio y pegalo abajo:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# NUNCA subas el .env real al repositorio (.gitignore ya lo excluye).
# start-revo.ps1 genera todo esto automaticamente si falta.
# ============================================================

# ─── PostgreSQL ───────────────────────────────
# docker-compose lee estas variables. Si falta alguna, el arranque
# falla con un mensaje claro en vez de usar un valor por defecto.
POSTGRES_DB=revo_db
POSTGRES_USER=revo_user
POSTGRES_PASSWORD=cambia_esta_password

# ─── Autenticacion ────────────────────────────
# Los 3 microservicios DEBEN compartir exactamente el mismo valor:
# cada uno valida los tokens que emiten los otros.
#
# Sin valor por defecto a proposito. Un secreto publicado en el
# repositorio permite a cualquiera firmar un token de administrador
# y tomar control total del sistema.
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ─── Conexion a la base de datos ──────────────
# Dentro de Docker el host es "postgres". Para los servicios
# corriendo en local contra el Postgres dockerizado, es
# localhost:5434 (ver start-revo.ps1).
DATABASE_URL=postgresql://revo_user:cambia_esta_password@postgres:5432/revo_db

# ─── URLs entre servicios ─────────────────────
AUTH_SERVICE_URL=http://auth-service:8001
SURVEY_SERVICE_URL=http://survey-service:8002
ML_SERVICE_URL=http://ml-service:8003

# ─── Frontend ─────────────────────────────────
# En desarrollo el proxy de vite.config.js apunta a 8011/8012/8013,
# asi que estas solo hacen falta para el despliegue.
VITE_AUTH_API=http://localhost:8001
VITE_SURVEY_API=http://localhost:8002
VITE_ML_API=http://localhost:8003
