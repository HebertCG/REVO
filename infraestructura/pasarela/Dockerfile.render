# ============================================================
# Pasarela para el despliegue en Render
# ============================================================
# En el compose la pasarela usa la imagen oficial de nginx con la plantilla
# montada como volumen. Render no monta volumenes del repositorio, asi que
# la plantilla tiene que ir dentro de la imagen.
#
# Diferencia de fondo con el compose: en Render los servicios no estan en
# una red interna, son URLs publicas de HTTPS. Por eso se usa una plantilla
# distinta que resuelve nombres externos y habla TLS con ellos.
# ============================================================
FROM nginx:1.27-alpine

# La imagen oficial procesa /etc/nginx/templates/*.template con envsubst al
# arrancar y sustituye solo las variables ${NOMBRE} presentes en el entorno.
COPY nginx.render.conf.template /etc/nginx/templates/nginx.conf.template

ENV NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx

# Averigua el DNS del contenedor antes de rellenar la plantilla. El 15 lo
# coloca antes del 20-envsubst-on-templates.sh de la imagen oficial, y la
# extension .envsh hace que se ejecute con `source`, para que el export
# llegue al envsubst.
COPY resolver.envsh /docker-entrypoint.d/15-resolver.envsh
RUN chmod +x /docker-entrypoint.d/15-resolver.envsh

# La plantilla usa ${PORT} en el `listen`. Si la variable no existe,
# envsubst la sustituye por vacio y nginx muere con "invalid port".
# Render pisa este valor con el suyo; el compose se queda en 80.
ENV PORT=80

EXPOSE 80
